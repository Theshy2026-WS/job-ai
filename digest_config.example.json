{
  "resume_path": "resumes/resume.pdf",
  "recipient": "you@example.com",
  "employers_path": "digest_employers.json",
  "data_dir": "job_hunter/data/digest",
  "min_score": 45,
  "max_posting_age_months": 1,
  "timeout_seconds": 12,
  "max_workers": 8,
  "email": {
    "host": "smtp.gmail.com",
    "port": 465,
    "username": "you@gmail.com",
    "sender": "you@gmail.com"
  },
  "rules_version": 2,
  "experience_years": 8,
  "discovery": {
    "enabled": true,
    "directory_path": "employer_directory.json",
    "search_queries": [
      "\"data engineer\" (GCP OR AWS OR Snowflake) \"United States\" careers -site:linkedin.com",
      "\"data engineer\" site:google.com/about/careers",
      "\"data engineer\" site:amazon.jobs"
    ]
  },
  "job_boards": {
    "enabled": true
  }
}
